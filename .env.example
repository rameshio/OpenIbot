# Local development only. Copy this file to .env.local; never commit real secrets.
# Required: choose a private local workspace password of at least 16 characters.
IBOT_LOCAL_PASSWORD=

# Optional server-side provider credentials. Set BOTH values for a provider.
# Leave blank to enter session-only credentials through the API Keys screen.
# Use an exact text-generation model ID from the provider's official model list.
# No model IDs are preselected and no provider is chosen as an automatic fallback.
# Test connections in the UI before starting a task; tests may incur charges.

# https://ai.google.dev/gemini-api/docs/models
GEMINI_API_KEY=
GEMINI_MODEL=

# https://developers.openai.com/api/docs/models
OPENAI_API_KEY=
OPENAI_MODEL=

# https://platform.claude.com/docs/en/about-claude/models/overview
ANTHROPIC_API_KEY=
ANTHROPIC_MODEL=

# https://docs.x.ai/docs/models
XAI_API_KEY=
XAI_MODEL=

# https://docs.cohere.com/docs/models
COHERE_API_KEY=
COHERE_MODEL=

# Never rename credential variables with NEXT_PUBLIC_ or put them in client code.
# Restart the local server after changing this file.
